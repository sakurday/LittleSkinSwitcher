{
	"schemaVersion": 1,
	"id": "littleskin-switcher",
	"version": "${version}",
	"name": "LittleSkin Switcher",
	"description": "在游戏内管理多个 Yggdrasil（皮肤站）账户，并为每个服务器单独指定要用哪个账户进入。默认使用启动器登录，LittleSkin 只是其中一个预设地址。皮肤显示请配合 CustomSkinLoader 之类的模组。",
	"authors": [
		"sakurday"
	],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.littleskin.switcher.LittleSkinSwitcher"
		]
	},
	"mixins": [
		"littleskin-switcher.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"fabric-api": ">=0.155.2",
		"minecraft": "~26.1.2",
		"java": ">=25"
	}
}
